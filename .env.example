# Backend application port
PORT=3001

# Notice that we do not need superuser credential anymore.
POSTGRES_DB=mydb
POSTGRES_USER=postgres # Superuser username
POSTGRES_PASSWORD=1234 # Change this to your desired password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=5678 # Change this to your desired password

# Cloudflare Tunnel token (only needed if you want to use Cloudflare Tunnel)
CF_TUNNEL_TOKEN=

DEBUG=pf*